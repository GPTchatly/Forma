# Hosted Vercel configuration. Set secrets in Vercel's environment settings.
# Optional operator-funded allowance; never place real secrets in this example.
# With no operator key, visitors can still bring their own, saved only in their browser.
TYPESAFE_API_KEY=
OPENROUTER_API_KEY=
JEV_MODEL=jev-1.13.0
JEV_PROVIDER=auto
# Deployment-wide free provider-call ceiling per UTC day (1 through 5000).
FORMA_FREE_GLOBAL_DAILY_LIMIT=500
PUBLIC_ORIGIN=https://forma.example.com
# Generate independent random base64url values (at least 32 random bytes each).
FORMA_SESSION_SECRET=
# Cloudflare must overwrite X-Forma-Edge-Token with this secret on API requests.
FORMA_EDGE_SECRET=
# Cloudflare Turnstile before live key tests and designs: exactly on or off.
# Unset or any other value stops live JEV until it is set.
TURNSTILE_ENFORCE=on
# Public widget sitekey; the browser receives it only from /api/status.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Signs the browser-check pass: 32+ printable characters, not FORMA_SESSION_SECRET.
TURNSTILE_SESSION_SECRET=
# Must include the PUBLIC_ORIGIN hostname; tokens for any other hostname are refused.
TURNSTILE_ALLOWED_HOSTNAMES=forma.example.com
QWEN3_KV_REST_API_URL=
QWEN3_KV_REST_API_TOKEN=
# Provider-call units per minute per session and per API key; one design reserves two.
QWEN3_LIMIT=10
# Existing integration variables below are not used by Forma's REST limiter.
QWEN3_KV_URL=
QWEN3_KV_REST_API_READ_ONLY_TOKEN=
QWEN3_REDIS_URL=
