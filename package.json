{
  "name": "jev-site-studio",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "A local-first website builder with a Vercel BYOK hosting adapter.",
  "engines": {
    "node": ">=22.23.3 <23 || >=24.21.0 <25"
  },
  "scripts": {
    "start": "node server/index.mjs --open",
    "dev": "node --watch server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "build": "node scripts/build-hosted.mjs",
    "release:check": "node scripts/release-check.mjs",
    "release:source": "node scripts/release-source.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "zod": "4.6.7"
  }
}
